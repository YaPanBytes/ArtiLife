{
  "name": "artilife",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Artificial life ecosystem: evolving neural-net creatures on a 2D map.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "sim": "tsx src/cli/run.ts",
    "bench": "tsx src/cli/bench.ts",
    "e2e": "node e2e/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0"
  }
}
